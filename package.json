{
  "name": "autopilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env DATASET_STORAGE_ROOT=C:/autopilotdata next dev --turbopack",
    "prebuild": "node scripts/build-workers.mjs",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "bench:execution": "tsx scripts/bench/execution-400mb-benchmark.ts",
    "inngest:dev": "inngest-cli dev",
    "worker:parse": "cross-env DATASET_STORAGE_ROOT=C:/autopilotdata tsx watch src/workers/csv-parse.worker.ts",
    "worker:join": "cross-env DATASET_STORAGE_ROOT=C:/autopilotdata tsx watch src/workers/csv-join.worker.ts",
    "worker:sort": "cross-env DATASET_STORAGE_ROOT=C:/autopilotdata tsx watch src/workers/csv-sort.worker.ts",
    "worker:sequence": "cross-env DATASET_STORAGE_ROOT=C:/autopilotdata tsx watch src/workers/csv-consecutive-sequence.worker.ts",
    "worker:filter": "cross-env DATASET_STORAGE_ROOT=C:/autopilotdata tsx watch src/workers/csv-filter.worker.ts",
    "worker:aggregate": "cross-env DATASET_STORAGE_ROOT=C:/autopilotdata tsx watch src/workers/csv-aggregate.worker.ts",
    "worker:compare": "cross-env DATASET_STORAGE_ROOT=C:/autopilotdata tsx watch src/workers/csv-compare.worker.ts",
    "worker:deduplicate": "cross-env DATASET_STORAGE_ROOT=C:/autopilotdata tsx watch src/workers/csv-deduplicate.worker.ts",
    "worker:transform": "cross-env DATASET_STORAGE_ROOT=C:/autopilotdata tsx watch src/workers/csv-transform.worker.ts",
    "dev:all": "concurrently --names \"next,parse,join,sort,sequence,filter,aggregate,compare,deduplicate,inngest\" --prefix-colors \"cyan,green,yellow,blue,magenta,red,white,cyan,green,blue\" \"npm run dev\" \"npm run worker:parse\" \"npm run worker:join\" \"npm run worker:sort\" \"npm run worker:sequence\" \"npm run worker:filter\" \"npm run worker:aggregate\" \"npm run worker:compare\" \"npm run worker:deduplicate\" \"npm run inngest:dev\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@paralleldrive/cuid2": "github:paralleldrive/cuid2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
