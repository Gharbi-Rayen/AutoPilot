    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/toposort": "^2.0.7",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "mprocs": "^0.8.2",
    "tailwindcss": "^4",
