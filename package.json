    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "embla-carousel-react": "^8.6.0",
    "fast-csv": "^5.0.5",
    "fast-json-stable-stringify": "^2.1.0",
    "handlebars": "^4.7.8",
